<?xml version="1.0" encoding="utf-8"?>
<!-- الإشعار موسّعاً: الصلاة، العدّاد الكبير، موعدا الأذان والإقامة، ومواقيت اليوم الستة. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_prayer_card_normal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_capsule"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/bigTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أذان العصر"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/bigCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layoutDirection="ltr"
        android:textDirection="ltr"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <!-- أندرويد 6 وأقدم: ساعة الموعد بدل العدّاد -->
    <TextView
        android:id="@+id/bigTargetTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/countdownLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="متبقٍ لأذان العصر"
        android:textColor="#DDFFFFFF"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/bigDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="الأذان 3:48 م • الإقامة 4:08 م"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cell0"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_time_chip">

            <TextView
                android:id="@+id/cell0Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/cell0Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="5:05"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_time_chip">

            <TextView
                android:id="@+id/cell1Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/cell1Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="6:28"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_time_chip">

            <TextView
                android:id="@+id/cell2Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/cell2Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="12:26"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_time_chip">

            <TextView
                android:id="@+id/cell3Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/cell3Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="3:48"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_time_chip">

            <TextView
                android:id="@+id/cell4Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/cell4Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="6:22"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_time_chip">

            <TextView
                android:id="@+id/cell5Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/cell5Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="7:40"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
